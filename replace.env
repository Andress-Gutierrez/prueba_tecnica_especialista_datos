# Copiar a .env y ajustar valores. El archivo .env NO se versiona.

# Base de datos (Data Warehouse)
POSTGRES_DB=dwh_comercial
POSTGRES_USER=dwh_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Nombre del contenedor Docker (opcional; default en docker-compose.yml)
POSTGRES_CONTAINER_NAME=prueba_tecnica_postgres

# ---------------------------------------------------------------------------
# Apache Airflow (Subfase 5.1) — variables de orquestación únicamente
# ---------------------------------------------------------------------------

# Imagen fija (no usar latest)
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.3

# UID del usuario en contenedores Airflow (Windows/macOS: 50000)
AIRFLOW_UID=50000

# Base de metadata de Airflow (misma instancia PostgreSQL, DB distinta al DW)
AIRFLOW_POSTGRES_DB=airflow

# Conexión SQLAlchemy a metadata Airflow (codificar caracteres especiales: ! -> %21)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dwh_user:cambiar_esta_clave@postgres:5432/airflow

# Puerto host del Web UI / API server
AIRFLOW_WEBSERVER_PORT=8080

# Credenciales iniciales del administrador UI (EJEMPLO — cambiar en entornos reales)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Claves de seguridad (EJEMPLO — regenerar para entornos reales)
# Generar FERNET: docker run --rm apache/airflow:3.1.3 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=fDnPNF0yIsZB1hIoo4lZokiGirglOy2NOxKkV8iJezU=
AIRFLOW_JWT_SECRET=_NcdyDKLn0bc2MKaud2228Npq6OuVWQ4srkCJHQlkTE

# URL de Execution API entre contenedores (LocalExecutor / AF 3.x)
# Debe apuntar al servicio webserver/api-server, no a localhost.
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/

# ---------------------------------------------------------------------------
# Calendario corporativo (Master Data) - API oficial de festivos Colombia
# ---------------------------------------------------------------------------
# Base URL de documentacion: https://www.festivos.com.co/api/documentacion
FESTIVOS_API_URL=https://www.festivos.com.co
FESTIVOS_API_KEY=colocar_api_key_valida

# Rango de anios para poblar dim_tiempo desde calendar_seed_dag
CALENDAR_START_YEAR=2025
CALENDAR_END_YEAR=2027
